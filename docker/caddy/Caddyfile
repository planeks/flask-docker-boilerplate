{
    log {
        output file /var/log/caddy/access.log
        format json
    }
}

{$SITE_DOMAIN} {
    @docs path /docs/*
    handle @docs {
        basic_auth {
            {$CADDY_USER:admin} {$CADDY_PASSWORD}
        }
        root * /docs
        file_server
    }

    reverse_proxy /flower/* flower:5555
    reverse_proxy /* flask:8000
}

