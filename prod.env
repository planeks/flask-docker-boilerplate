# An example. Copy it to .env and edit
COMPOSE_PROJECT_NAME=flask_app
ENVIRONMENT=prod
PYTHONENCODING=utf8
DEBUG=0
CONFIGURATION=prod
SECRET_KEY="<secret_key>"
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=db
POSTGRES_USER=dbuser
POSTGRES_PASSWORD=<db_password>
DATABASE_URL=postgresql://dbuser:<db_password>@postgres:5432/db
REDIS_URL=redis://redis:6379/0
SITE_DOMAIN=example.com
SITE_URL=https://example.com
EMAIL_HOST=
EMAIL_PORT=25
EMAIL_HOST_USER=<email_user>
EMAIL_HOST_PASSWORD=<email_password>
SENTRY_DSN=<sentry_dsn>
CELERY_FLOWER_USER=flower
CELERY_FLOWER_PASSWORD=<flower_password>
CADDY_PASSWORD=<caddy_password_hash>
